# Local development defaults for docker compose (`docker compose up`); every feature is on.
# Credentials here are dev-only. SeaweedFS takes its S3 key/secret from here too.

NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

##### Feature flags #####
NEXT_PUBLIC_ENABLE_SBOM_UPLOAD=true
NEXT_PUBLIC_ENABLE_SCAN_API=true
NEXT_PUBLIC_CVE_MAPPING_ENABLED=true

##### Artifact storage #####
# local: the bundled dataset in public/
ARTIFACT_BACKEND_TYPE=local
SBOM_DIR=public/sbom
CVE_DIR=public/cve
ARTIFACT_ROOT=./public

# S3 via the SeaweedFS service in compose (it uses the key/secret below). The app only uses it
# when ARTIFACT_BACKEND_TYPE=s3 (above); the bucket starts empty, so the bundled dataset is not there.
S3_ENDPOINT=http://seaweedfs:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=sbomvert
S3_SECRET_ACCESS_KEY=sbomvert-dev-secret
AWS_REGION=us-east-1
# The SBOM/CVE services always use the `sbomvert` bucket; S3_BUCKET/S3_PREFIX only affect the artifact store.
S3_BUCKET=sbomvert
S3_PREFIX=artifacts/

##### Scan API #####
REDIS_HOST=redis
REDIS_PORT=6379
# 1: concurrent trivy/grype runs fight over their shared cache lock
SCAN_CONCURRENCY=1
# per tool run, in ms
RUN_EXPERIMENT_TIMEOUT=180000
# worker: hours between vulnerability database refreshes (done between jobs)
DB_REFRESH_HOURS=24
# Docker Scout needs a Docker Hub account; without one, scout scans fail and the rest still run.
# DOCKER_SCOUT_HUB_USER=
# DOCKER_SCOUT_HUB_PASSWORD=
